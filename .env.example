# Array JSON de claves Alpha Vantage. Reemplazar [] por ["clave_1","clave_2"].
ALPHAVANTAGE_API_KEYS=[]
# Separación mínima de requests por clave, compartida por todos los lotes.
AV_MIN_REQUEST_INTERVAL_SECONDS=1.1
# Una clave limitada se omite hasta vencer este tiempo (o Retry-After HTTP).
AV_RATE_COOLDOWN_SECONDS=65
AV_DAILY_COOLDOWN_SECONDS=86400
